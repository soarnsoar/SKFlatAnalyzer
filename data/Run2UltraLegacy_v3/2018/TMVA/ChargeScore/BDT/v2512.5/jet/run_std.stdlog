                         :     BoostType: "Grad" [Boosting type for the trees in the forest (note: AdaCost is still experimental)]
                         :     UseBaggedBoost: "True" [Use only a random subsample of all events for growing the trees in each boost iteration.]
                         :     Shrinkage: "5.000000e-02" [Learning rate for BoostType=Grad algorithm]
                         :     AdaBoostBeta: "5.000000e-01" [Learning rate  for AdaBoost algorithm]
                         :     BaggedSampleFraction: "7.000000e-01" [Relative size of bagged event sample to original size of the data sample (used whenever bagging is used (i.e. UseBaggedBoost, Bagging,)]
                         :     SeparationType: "GiniIndex" [Separation criterion for node splitting]
                         : - Default:
                         :     VerbosityLevel: "Default" [Verbosity level]
